[
  {
    "name": "Switch to Live account with confirmation",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Switch to Live trading? Orders can use real funds."
            }
          }
        ],
        "send": {
          "callback": "account:switch"
        }
      },
      {
        "send": { "callback": "account:live:yes" },
        "expect": [{ "method": "editMessageText", "payload": { "text": "Trading is set to Live." } }]
      }
    ]
  }
]
